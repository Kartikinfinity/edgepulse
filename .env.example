# ---------------------------------------------------------------------------
# SIH KWS - machine-specific settings.
#
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# .env is git-ignored. NEVER commit real credentials.
# Every value below is OPTIONAL - the defaults are relative to the repo root
# and work unchanged on a fresh clone.
# Precedence: real environment variable > .env > built-in default.
# ---------------------------------------------------------------------------

# --- Paths -----------------------------------------------------------------
# Where the extracted solvani_kws_release dataset lives.
# Default: <repo>/data/solvani_kws_release
# Set this only if you keep the dataset outside the repository (e.g. another
# drive). Relative values are resolved against the repo root.
#SIH_DATASET_ROOT=data/solvani_kws_release

# Features, checkpoints, exported models. Default: <repo>/artifacts
#SIH_ARTIFACTS_DIR=artifacts

# OPTIONAL external corpus, only if you have it. Not required by any phase yet.
#SIH_SPEECH_COMMANDS_ROOT=/path/to/speech_commands

# --- Hardware --------------------------------------------------------------
# Serial port of the ESP32-S3. Leave unset to let PlatformIO auto-detect.
# Windows example: COM7        Linux example: /dev/ttyACM0
# NOTE: the port number differs per machine. Do not assume COM7.
#SIH_UPLOAD_PORT=

#SIH_MONITOR_BAUD=115200

# --- Server / demo ---------------------------------------------------------
#SIH_ASR_SERVER_HOST=0.0.0.0
#SIH_ASR_SERVER_PORT=8765
#SIH_DASHBOARD_PORT=8080

# --- SECRETS ---------------------------------------------------------------
# Wi-Fi credentials for the ESP32. REQUIRED before Phase G3.
# These are read at firmware build time and MUST NOT be committed.
# Leave blank here; fill them in your local .env only.
#SIH_WIFI_SSID=
#SIH_WIFI_PASSWORD=
